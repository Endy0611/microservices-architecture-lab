{
  "realm": "lab-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Standard authenticated user" },
      { "name": "ADMIN", "description": "Administrative user" }
    ]
  },
  "users": [
    {
      "username": "john",
      "enabled": true,
      "emailVerified": true,
      "firstName": "John",
      "lastName": "Doe",
      "email": "john@example.com",
      "credentials": [
        { "type": "password", "value": "john123", "temporary": false }
      ],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "admin-user@example.com",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["USER", "ADMIN"]
    }
  ],
  "clients": [
    {
      "clientId": "gateway-client",
      "name": "API Gateway Test Client",
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "enabled": true
    }
  ]
}
